{
  "name": "mbr-components",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.editor.config.ts && vite build --config vite.graph.config.ts && vite build --config vite.genealogy.config.ts && vite build --config vite.tasks.config.ts && vite build --config vite.review.config.ts && vite build --config vite.search-extras.config.ts && vite build --config vite.flashcards.config.ts && vite build --config vite.flashcards-reading.config.ts",
    "watch": "tsc && vite build --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --reporter=verbose"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.22.2",
    "d3-force": "^3.0.0",
    "family-chart": "^0.9.0",
    "lit": "^3.3.3",
    "mdast-util-to-markdown": "2.2.0",
    "micromark-factory-space": "2.1.0",
    "micromark-util-character": "2.1.1",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/mdast": "4.0.4",
    "happy-dom": "^20.14.5",
    "mdast-util-from-markdown": "2.1.0",
    "micromark-util-types": "2.0.3",
    "terser": "^5.51.2",
    "typescript": "~7.0.2",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "ws": "^8.20.1",
    "katex": "^0.18.11"
  }
}
