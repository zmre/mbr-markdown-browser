result-*
.direnv

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# A global core.excludesFile with the usual vim-swapfile pattern `*.sw*` also
# matches `*.swift`. New Swift sources then never get added, and because a nix
# flake only sees git-tracked files, `nix build .#mbr-quicklook` fails with
# "error opening input file ... (No such file or directory)" for a file that is
# plainly on disk. A repo .gitignore outranks core.excludesFile, so this undoes
# it here. (Ordinary .swp/.swo swapfiles are still caught by `*.sw?` above.)
!*.swift
.playwright-mcp

# macOS app template build artifacts (keep Info.plist and Resources/AppIcon.icns;
# Resources/Assets.car is copied in by scripts/build-macos-app.sh)
macos/MBR.app-template/Contents/MacOS/
macos/MBR.app-template/Contents/PlugIns/
macos/MBR.app-template/Contents/_CodeSignature/
macos/MBR.app-template/Contents/Resources/Assets.car

# Generated by `xcodegen generate` (apple/quicklook/build.sh)
apple/quicklook/MBRQuickLook.xcodeproj/

# Generated by apple/ios/build.sh (xcodegen, the Rust xcframework, scratch
# headers). apple/ios/Generated/ IS checked in (git add -f; see CLAUDE.md).
apple/ios/MBRMobile.xcodeproj/
apple/ios/MbrFFI.xcframework/
apple/ios/build/
apple/ios/MBRMobile/Info.plist
